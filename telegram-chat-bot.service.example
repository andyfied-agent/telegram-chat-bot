[Unit]
Description=Telegram chat bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/telegram-chat-bot
EnvironmentFile=%h/.config/telegram-chat-bot/env
ExecStart=%h/src/telegram-chat-bot/.venv/bin/python %h/src/telegram-chat-bot/telegram_chat_bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/src/telegram-chat-bot

[Install]
WantedBy=default.target
