TELEGRAM_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_ALLOWED_GROUP_IDS=  # Optional: comma-separated group chat IDs
TELEGRAM_REGISTRATION_FILE=~/.local/state/telegram-chat-bot/registrations.json
LLAMA_CPP_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_CPP_MODEL=ministral-3-3b-64k-q4_k_m.gguf
LLM_PROVIDER=llama.cpp
# Zero means unlimited for the default provider.
DEFAULT_DAILY_REQUEST_LIMIT=0
PROVIDER_DAILY_LIMITS={}
OPENROUTER_ENABLED=false
OPENROUTER_DAILY_REQUEST_LIMIT=50
# Maximum concurrent model requests (default: 2). Set to 1 for strict serialization.
MAX_CONCURRENT_REQUESTS=2
# Minimum seconds between requests per user (default: 1.0).
MODEL_REQUEST_INTERVAL=1.0
# Log directory (default: ~/.local/state/telegram-chat-bot/logs for portability)
# Override with /mnt/scratch/hermes/logs on compute01
TELEGRAM_BOT_LOG_DIR=~/.local/state/telegram-chat-bot/logs
# Optional: group access policy (all, approved_users, or admins). Default: all
GROUP_ACCESS_MODE=all
# Optional: JSON for per-user rate limit overrides, e.g., {"123": 30.0}
USER_RATE_LIMITS={}
